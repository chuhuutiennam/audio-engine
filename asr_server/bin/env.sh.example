# Local settings of one installation. Sourced by bin/start.sh, bin/stop.sh, bin/status.sh
# and by scripts/update.sh. In the run directory this file is bin/env.sh; scripts/update.sh
# creates it once and never overwrites it.
#
# A value set here replaces the same variable of the calling shell.

# Interpreter that has torch (CUDA build), vllm[audio] and the packages of requirements.txt.
# Default: python3 from PATH.
# PYTHON=/path/to/venv/bin/python

# The server has no Internet access: pip and the model libraries must not try to reach it.
export PIP_NO_INDEX=1
export PIP_DISABLE_PIP_VERSION_CHECK=1
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export HF_HUB_DISABLE_TELEMETRY=1

# Runtime of the tokenizers and of the vLLM workers.
export TOKENIZERS_PARALLELISM=false
export VLLM_WORKER_MULTIPROC_METHOD=spawn

# GPU used by the server (index as shown by nvidia-smi).
export CUDA_VISIBLE_DEVICES=0

# Upgrade: versions kept in backup/, and seconds to wait for the server after a restart
# (it must load the models in that time; 0 = do not check that it became ready).
# export ASR_BACKUP_KEEP=10
# export ASR_START_WAIT_SEC=300
